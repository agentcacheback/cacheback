#!/usr/bin/env bash
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
if [[ $(basename "$0") == pre-commit ]] && ! git diff --quiet; then
  echo 'Harness: stage or stash tracked edits first so the checked tree matches the commit.' >&2
  exit 1
fi
# Scrub linked-worktree Git variables before any test creates a fixture repository.
while IFS= read -r git_var; do unset "$git_var"; done < <(git rev-parse --local-env-vars)
exec "$root/.venv/bin/python" "$root/scripts/check.py"
