{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell|exec",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/block_no_verify.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent_hook.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
